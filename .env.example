# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
APP_URL=https://auth.ymatt.online
FRONTEND_URL=https://ymatt.online/dashboard

# Directus Configuration
DIRECTUS_URL=https://directus.ymatt.online
DIRECTUS_ADMIN_TOKEN=your-directus-admin-static-token-here

# Cookie / Session Security
COOKIE_SECRET=change-this-to-a-secure-random-string-at-least-32-chars-long
COOKIE_DOMAIN=.ymatt.online
COOKIE_SECURE=false

# Roles
DEFAULT_MEMBER_ROLE_NAME=Member
SERVICE_ROLE_NAME=Service Accounts

# OAuth / SSO Providers (Comma-separated)
AUTH_PROVIDERS=google,github
