{
  "name": "aaaauutttooo",
  "version": "1.0.0",
  "description": "Directus-Powered Headless Authentication BFF and API Gateway",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src/__tests__/unit",
    "test:int": "vitest run src/__tests__/integration",
    "seed": "tsx src/scripts/seed.ts"
  },
  "keywords": [
    "directus",
    "auth",
    "fastify",
    "session",
    "bff"
  ],
  "author": "Martin Ray Gales (Ymatt)",
  "license": "ISC",
  "dependencies": {
    "@directus/sdk": "^19.1.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "qrcode": "^1.5.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
